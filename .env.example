# Portkey AI gateway configuration (LLM layer)
# Values mirror the Portkey access configured in Claude's settings.json.
# Copy this file to `.env` and adjust as needed. Never commit the real .env.

PORTKEY_BASE_URL=https://portkeygateway.perficient.com/v1
PORTKEY_API_KEY=
PORTKEY_PROVIDER=@dsvertex
PORTKEY_MODEL=gemini-2.5-flash

# Server
HOST=127.0.0.1
PORT=8000

# PostgreSQL -- the system of record. See docs/database.md for first-time setup.
# Note the "+psycopg" dialect tag: SQLAlchemy needs it, and backend.config
# strips it for libraries that want a plain libpq URI.
DATABASE_URL=postgresql+psycopg://offboard:CHANGE_ME@localhost:5432/offboard
TEST_DATABASE_URL=postgresql+psycopg://offboard:CHANGE_ME@localhost:5432/offboard_test

# FAQ RAG pipeline (Portkey-hosted embeddings + persistent vector DB)
CHROMA_DIR=data/.chroma
RAG_COLLECTION=exit_docs
EMBED_MODEL=@azure-openai/text-embedding-3-small
RAG_CHUNK_CHARS=750
RAG_CHUNK_OVERLAP=110
RAG_TOP_K=5
RAG_CANDIDATES=12
