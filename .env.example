# Portkey AI gateway configuration (LLM layer)
# Values mirror the Portkey access configured in Claude's settings.json.
# Copy this file to `.env` and adjust as needed. Never commit the real .env.

PORTKEY_BASE_URL=https://portkeygateway.perficient.com/v1
PORTKEY_API_KEY=
PORTKEY_PROVIDER=@aws-bedrock-use2
PORTKEY_MODEL=us.anthropic.claude-sonnet-5

# Server
HOST=127.0.0.1
PORT=8000

# FAQ RAG pipeline (Portkey-hosted embeddings + persistent vector DB)
CHROMA_DIR=data/.chroma
RAG_COLLECTION=exit_docs
EMBED_MODEL=@azure-openai/text-embedding-3-small
RAG_CHUNK_CHARS=750
RAG_CHUNK_OVERLAP=110
RAG_TOP_K=5
RAG_CANDIDATES=12
